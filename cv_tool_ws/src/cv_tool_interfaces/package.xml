<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cv_tool_interfaces</name>
  <version>0.1.0</version>
  <description>
    Action definitions for the ARISE-KIRO cv_tool module. Provides the Detect action used to
    request detection and 3D localization of a named industrial tool.
  </description>
  <maintainer email="nick.kardaris@gmail.com">Nikos Kardaris</maintainer>
  <license>AGPL-3.0-or-later</license>
  <url type="repository">https://github.com/nkardaris/arise-kiro-cv-tool</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>  

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
