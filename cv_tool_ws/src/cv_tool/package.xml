<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cv_tool</name>
  <version>0.1.0</version>
  <description>
    ARISE-KIRO tool recognition module: a ROS 2 / Vulcanexus action server that detects
    industrial tools for robotic picking using Ultralytics YOLO (OpenVINO) and deprojects
    2D bounding boxes into 3D metric coordinates using aligned RGB-D camera data.
  </description>
  <maintainer email="nick.kardaris@gmail.com">Nikos Kardaris</maintainer>
  <license>AGPL-3.0-or-later</license>
  <url type="repository">https://github.com/nkardaris/arise-kiro-cv-tool</url>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- ROS 2 runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>cv_tool_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- System / Python dependencies -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!--
    Pip-only dependencies with no rosdep keys (installed via the Dockerfile):
    ultralytics, openvino, torch. See docs/03_installation_and_hello_world.md.
  -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
