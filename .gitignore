# ROS 2 / colcon build artifacts
cv_tool_ws/build/
cv_tool_ws/install/
cv_tool_ws/log/

# Python cache / virtual env
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.env/

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# IDE/editor settings
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Runtime/debug outputs
output_images_*/
*.log

# Recorded rosbags are distributed as external downloads, never committed (see
# cv_tool_ws/src/cv_tool/examples/bags/README.md)
*.db3
*.mcap
**/bags/**/metadata.yaml

# Word documents (D4 report + template) are submission artifacts, kept out of git.
# Regenerate the filled report with docs/_fill_template_docx.py.
*.docx
